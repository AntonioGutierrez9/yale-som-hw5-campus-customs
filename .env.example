# Copy this file to .env (in the repo root) and fill in your own values.
# .env is ignored by git, so your real key is never committed.

# Required: Portkey API key used for every agent call (model: gpt-6-luna only)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: only these people may approve/reject/undo in the dashboard (comma-separated full names).
# Leave empty to allow any real first + last name (agent/AI/system names are always refused).
HUMAN_APPROVERS=

# Optional execution limits (defaults shown). Don't raise them without a reason: they cap token use.
CC_MAX_STEPS_PER_TICKET=25
CC_MAX_STEPS_PER_AGENT=5
CC_MAX_DELEGATION_DEPTH=4
CC_MAX_DELEGATIONS_PER_RUN=6
CC_MAX_OUTPUT_TOKENS_PER_CALL=2000
CC_MAX_TOKENS_PER_TICKET=200000
CC_MAX_TOOL_CALLS_PER_TICKET=50
